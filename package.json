{
  "name": "solana-swap-api",
  "version": "1.0.0",
  "description": "Solana Vybe swap quote & unsigned tx build — demo API + GUI",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "npm run build:frontend && tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "build:frontend": "node tools/bundle-frontend.mjs",
    "typecheck:frontend": "tsc -p tsconfig.frontend.json",
    "fetch:catalog": "node tools/fetch-jupiter-token-catalog.mjs",
    "filter:catalog": "node tools/filter-catalog-by-sol-quote.mjs",
    "analyze:failures": "node tools/analyze-filter-failures.mjs",
    "scrape:solscan": "node tools/scrape-solscan-markets.mjs",
    "compare:routes": "node tools/compare-route-vs-solscan.mjs",
    "analyze:markets": "node tools/filter-catalog-by-sol-quote.mjs",
    "refresh:catalog:local": "CATALOG_FILTER_RESET_DENYLIST=1 npm run fetch:catalog && SWAP_API=http://127.0.0.1:3007 npm run filter:catalog",
    "download:token-icons": "node tools/download-token-icons.mjs",
    "prod-like-proxy": "node tools/local-vybe-proxy.mjs",
    "prod-like-local": "bash tools/run-prod-like-local.sh",
    "prestart": "npm run build:frontend"
  },
  "keywords": [
    "solana",
    "swap",
    "vybe",
    "api"
  ],
  "license": "MIT",
  "dependencies": {
    "@solana/web3.js": "1.98.4",
    "axios": "1.7.9",
    "dotenv": "16.4.5",
    "express": "4.21.1",
    "undici": "^6.21.0"
  },
  "devDependencies": {
    "@types/express": "5.0.0",
    "@types/node": "22.10.1",
    "tsx": "4.19.2",
    "typescript": "5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
