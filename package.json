{
  "name": "solana-swap-api",
  "version": "1.0.0",
  "description": "Solana Vybe swap quote & unsigned tx build — demo API + GUI",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "build:frontend": "tsc -p tsconfig.frontend.json",
    "fetch:catalog": "node tools/fetch-jupiter-token-catalog.mjs",
    "download:token-icons": "node tools/download-token-icons.mjs",
    "prestart": "npm run build:frontend"
  },
  "keywords": ["solana", "swap", "vybe", "api"],
  "license": "MIT",
  "dependencies": {
    "@solana/web3.js": "1.98.4",
    "axios": "1.7.9",
    "dotenv": "16.4.5",
    "express": "4.21.1"
  },
  "devDependencies": {
    "@types/express": "5.0.0",
    "@types/node": "22.10.1",
    "typescript": "5.6.3",
    "tsx": "4.19.2"
  },
  "engines": {
    "node": ">=20"
  }
}

