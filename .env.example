# Get your API key at https://docs.vybenetwork.com
VYBE_API_KEY=your_api_key_here

# Optional: Vybe API base URL (default: https://api.vybenetwork.xyz)
# Prod-like local testing: run tools/run-prod-like-local.sh (ix-builder + local Vybe proxy),
# then point swap-api at the proxy (swap routes → local ix-builder; tokens/balances → prod Vybe).
# VYBE_API_BASE=http://127.0.0.1:8080

# Optional: Server port (default 3000)
# PORT=3000

# Optional: Solana RPC for token-account checks (default: public mainnet)
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

