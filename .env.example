# Get your API keys at https://vybenetwork.com/pricing
# Trading (swap quote/build on VYBE_API_BASE). Leave empty for local Rust with permissions off.
VYBE_API_KEY=
# Wallets, tokens, trades (VYBE_DATA_API_BASE). Required when trading uses a different base/key.
VYBE_DATA_API_KEY=your_api_key_here

# Optional: Vybe API base URL (default: https://api.vybenetwork.xyz)
# Local Rust / proxy for swap testing:
# VYBE_API_BASE=http://127.0.0.1:8090
# Wallets, tokens, and trades still use prod unless you override:
# VYBE_DATA_API_BASE=https://api.vybenetwork.xyz

# Optional: Server port (default 3000)
# PORT=3000

# Optional: Solana RPC for wallet balances, blockhash, browser RPC proxy.
# Priority: SOLANA_RPC_URL (full URL) → HELIUS_API_KEY → public mainnet.
# HELIUS_API_KEY=your_helius_api_key_here
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Optional: show inline "Get quote blocked" debug meta under the quote button (default: off)
# ENABLE_SWAP_QUOTE_BTN_DEBUG=true

