# Get your API key at https://docs.vybenetwork.com
VYBE_API_KEY=your_api_key_here

# Optional: Vybe router swap destination (default: remote Vybe API /v4/trading/swap)
# Set to "local" to POST swap builds to ix-builder on localhost instead.
# vybe_api_location=local
# IX_BUILDER_LOCAL_URL=http://localhost:8000

# Optional: Server port (default 3000)
# PORT=3000

# Optional: Solana RPC for token-account checks (default: public mainnet)
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

